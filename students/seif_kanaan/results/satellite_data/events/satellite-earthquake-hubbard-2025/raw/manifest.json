    "id": "satellite-earthquake-hubbard-2025",
    "hazard": "earthquake",
    "title": "2025 Hubbard Glacier earthquake — Mount King George radar surface change",
    "event_date": "2025-12-06",
    "location": "Mount King George, Kluane region, Yukon, Canada",
    "method": "Matched Sentinel-1A VV/VH amplitude change on conservative low-slope support; pre-event repeat diagnostic",
    "sources": [
      {
        "label": "USGS documented landslide response and Yukon reconnaissance",
        "url": "https://www.usgs.gov/programs/landslide-hazards/science/2025-m70-hubbard-glacier-earthquake-triggered-landslides-and"
      },
      {
        "label": "USGS provisional same-acquisition SAR difference (context, not independent truth)",
        "url": "https://doi.org/10.5066/P14H7MVU"
      },
      {
        "label": "Earth Engine Sentinel-1 preprocessing",
        "url": "https://developers.google.com/earth-engine/guides/sentinel1"
      },
      {
        "label": "Copernicus GLO30 2024_1 dataset",
        "url": "https://developers.google.com/earth-engine/datasets/catalog/COPERNICUS_DEM_GLO30_2024_1",
        "attribution": "produced using Copernicus WorldDEM-30 © DLR e.V. 2010-2014 and © Airbus Defence and Space GmbH 2014-2018 provided under COPERNICUS by the European Union and ESA; all rights reserved",
        "licence_notice": "The organisations in charge of the Copernicus programme by law or by delegation do not incur any liability for any use of the Copernicus WorldDEM-30"
